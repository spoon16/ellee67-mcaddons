{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "biomejs.biome",
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "files.exclude": {
    "dist": true,
    ".codegen-work": true,
    ".bds": true
  },
  "search.exclude": {
    "dist": true,
    ".codegen-work": true,
    "tools/codegen/pets/integration": true,
    ".bds": true
  },
  "files.eol": "\n",
  "typescript.tsdk": "node_modules/typescript/lib",
  "json.schemas": [
    {
      "fileMatch": ["resource_packs/*/manifest.json"],
      "url": "./node_modules/@minecraft/bedrock-schemas/schemas/rp/manifest/index.schema.json"
    },
    {
      "fileMatch": ["behavior_packs/*/manifest.json"],
      "url": "./node_modules/@minecraft/bedrock-schemas/schemas/bp/manifest/index.schema.json"
    },
    {
      "fileMatch": ["behavior_packs/**/entities/**/*.json", "tools/bds/gametest/**/entities/**/*.json"],
      "url": "./node_modules/@minecraft/bedrock-schemas/schemas/bp/entities/index.schema.json"
    },
    {
