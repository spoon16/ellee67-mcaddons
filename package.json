{
  "name": "ellee67-mcaddons",
  "version": "0.2.3",
  "private": true,
  "description": "ElleeDog 67: one Minecraft Bedrock .mcaddon holding six self-contained features, each its own behavior pack (and resource pack where needed).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsx tools/build.ts",
    "package": "tsx tools/package.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:engine": "tsx tools/bds/smoke.ts",
    "test:gametest": "tsx tools/bds/gametest.ts",
    "bds:setup": "tsx tools/bds/setup.ts",
    "check": "tsc --noEmit && biome check .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "codegen": "tsx tools/codegen/run.ts",
    "codegen:test": "tsx tools/codegen/run.ts --python-tests-only",
    "bump": "tsx tools/set-version.ts",
    "version": "tsx tools/set-version.ts --from-package && git add behavior_packs resource_packs",
    "manifests": "tsx tools/manifests.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@minecraft/bedrock-schemas": "^1.26.20-beta.21",
    "@minecraft/server": "^2.9.0",
    "@minecraft/server-ui": "^2.0.0",
    "@minecraft/vanilla-data": "^1.26.44",
    "@types/node": "^24.13.4",
    "@types/pngjs": "^6.0.5",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "jsonc-parser": "^3.3.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
