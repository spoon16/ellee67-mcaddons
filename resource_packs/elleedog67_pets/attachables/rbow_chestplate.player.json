{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "elleedog:rbow_chestplate.player",
      "item": {
        "elleedog:rbow_chestplate": "query.owner_identifier == 'minecraft:player'"
      },
      "materials": {
        "default": "armor",
        "enchanted": "armor_enchanted"
      },
      "textures": {
        "default": "textures/models/armor/rbow_1",
        "enchanted": "textures/misc/enchanted_actor_glint"
      },
      "geometry": {
        "default": "geometry.player.armor.chestplate",
        "pet_carter": "geometry.pet.carter.armor.chestplate",
        "pet_mochi": "geometry.pet.mochi.armor.chestplate",
        "pet_casper": "geometry.pet.casper.armor.chestplate"
      },
      "scripts": {
        "initialize": [
          "variable.pet_fit_index = 0.0;"
        ],
        "parent_setup": "variable.chest_layer_visible = 0.0;",
        "pre_animation": [
          "variable.pet_fit_index = ((query.owner_identifier == 'minecraft:player') && !context.is_first_person && (context.owning_entity->query.has_property('pet:armor_fit') ? context.owning_entity->query.property('pet:armor_fit') : 0.0)) ? ((context.owning_entity->query.has_property('pet:model_id') ? context.owning_entity->query.property('pet:model_id') : 0.0) == 1 ? 1.0 : ((context.owning_entity->query.has_property('pet:model_id') ? context.owning_entity->query.property('pet:model_id') : 0.0) == 2 ? 2.0 : ((context.owning_entity->query.has_property('pet:model_id') ? context.owning_entity->query.property('pet:model_id') : 0.0) == 3 ? 3.0 : 0.0))) : 0.0;"
        ],
        "animate": [
          "offset",
          {
            "pet_fit": "variable.pet_fit_index > 0.0"
          }
        ]
      },
      "animations": {
        "offset": "animation.armor.chestplate.offset",
        "pet_fit": "animation.pet.armor_fit"
      },
      "render_controllers": [
        "controller.render.pet.armor_native",
        "controller.render.pet.armor_carter",
        "controller.render.pet.armor_mochi",
        "controller.render.pet.armor_casper"
      ]
    }
  }
}
