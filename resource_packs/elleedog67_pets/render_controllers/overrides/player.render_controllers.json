{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.player.first_person": {
      "geometry": "Array.pet_models[variable.pet_fp_paws ? variable.pet_index : 0.0]",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.pet_coats[variable.pet_fp_paws ? variable.pet_index : 0.0]"
      ],
      "part_visibility": [
        {
          "*": false
        },
        {
          "rightArm": "(query.get_equipped_item_name(0, 1) == '' || query.get_equipped_item_name(0, 1) == 'filled_map') && !variable.pet_ui_hide"
        },
        {
          "rightSleeve": "(query.get_equipped_item_name(0, 1) == '' || query.get_equipped_item_name(0, 1) == 'filled_map') && !variable.pet_ui_hide"
        },
        {
          "leftArm": "((query.get_equipped_item_name(0, 1) == 'filled_map' && query.get_equipped_item_name('off_hand') != 'shield') || (query.get_equipped_item_name('off_hand') == 'filled_map' && !query.item_is_charged) || (!query.item_is_charged && (variable.item_use_normalized > 0 && variable.item_use_normalized < 1.0))) && !variable.pet_ui_hide"
        },
        {
          "leftSleeve": "((query.get_equipped_item_name(0, 1) == 'filled_map' && query.get_equipped_item_name('off_hand') != 'shield') || (query.get_equipped_item_name('off_hand') == 'filled_map' && !query.item_is_charged) || (!query.item_is_charged && (variable.item_use_normalized > 0 && variable.item_use_normalized < 1.0))) && !variable.pet_ui_hide"
        },
        {
          "pet_fp_right_paw": "((query.get_equipped_item_name(0, 1) == '' || query.get_equipped_item_name(0, 1) == 'filled_map') && ((((query.has_property('pet:model_id') ? query.property('pet:model_id') : 0.0) == 1 ? 1.0 : ((query.has_property('pet:model_id') ? query.property('pet:model_id') : 0.0) == 2 ? 2.0 : ((query.has_property('pet:model_id') ? query.property('pet:model_id') : 0.0) == 3 ? 3.0 : 0.0))) > 0.0) && variable.is_first_person && !variable.map_face_icon && !query.is_spectator && (query.has_property('pet:view') ? query.property('pet:view') == 'paws' : 1.0))) && !variable.pet_ui_hide"
        },
        {
          "pet_fp_left_paw": "(((query.get_equipped_item_name(0, 1) == 'filled_map' && query.get_equipped_item_name('off_hand') != 'shield') || (query.get_equipped_item_name('off_hand') == 'filled_map' && !query.item_is_charged) || (!query.item_is_charged && (variable.item_use_normalized > 0 && variable.item_use_normalized < 1.0))) && ((((query.has_property('pet:model_id') ? query.property('pet:model_id') : 0.0) == 1 ? 1.0 : ((query.has_property('pet:model_id') ? query.property('pet:model_id') : 0.0) == 2 ? 2.0 : ((query.has_property('pet:model_id') ? query.property('pet:model_id') : 0.0) == 3 ? 3.0 : 0.0))) > 0.0) && variable.is_first_person && !variable.map_face_icon && !query.is_spectator && (query.has_property('pet:view') ? query.property('pet:view') == 'paws' : 1.0))) && !variable.pet_ui_hide"
        }
      ],
      "arrays": {
        "geometries": {
          "Array.pet_models": [
            "Geometry.default",
            "Geometry.pet_carter_paws",
            "Geometry.pet_mochi_paws",
            "Geometry.pet_casper_paws"
          ]
        },
        "textures": {
          "Array.pet_coats": [
            "Texture.default",
            "Texture.pet_carter_paws",
            "Texture.pet_mochi_paws",
            "Texture.pet_casper_paws"
          ]
        }
      },
      "rebuild_animation_matrices": true
    },
    "controller.render.player.third_person": {
