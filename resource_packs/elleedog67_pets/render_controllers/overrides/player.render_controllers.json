        },
        {
          "leftArmArmor": "(variable.chest_layer_visible && !query.has_cape) && !variable.pet_tp && !variable.pet_ui_hide_body"
        },
        {
          "rightArmArmor": "(variable.chest_layer_visible && !query.has_cape) && !variable.pet_tp && !variable.pet_ui_hide_body"
        },
        {
          "belt": "(variable.chest_layer_visible && variable.leg_layer_visible) && !variable.pet_tp && !variable.pet_ui_hide_body"
        }
