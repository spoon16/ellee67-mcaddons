{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.pet.shield": {
      "rebuild_animation_matrices": true,
      "arrays": {
        "geometries": {
          "Array.shield_left": [
            "Geometry.default",
            "Geometry.pet_carter_left",
            "Geometry.pet_mochi_left",
            "Geometry.pet_casper_left"
          ],
          "Array.shield_right": [
            "Geometry.default",
            "Geometry.pet_carter_right",
            "Geometry.pet_mochi_right",
            "Geometry.pet_casper_right"
          ]
        }
      },
      "geometry": "context.item_slot == 'off_hand' ? Array.shield_left[variable.pet_shield_index] : Array.shield_right[variable.pet_shield_index]",
      "materials": [
        {
          "*": "variable.is_enchanted ? Material.enchanted : Material.default"
        }
      ],
      "textures": [
        "Texture.default",
        "Texture.enchanted"
      ]
    }
  }
}
