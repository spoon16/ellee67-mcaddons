{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.player.third_person": {
      "arrays": {
        "geometries": {
          "Array.cav_diag_geo": [
            "Geometry.default",
            "Geometry.carter"
          ]
        },
        "textures": {
          "Array.cav_diag_tex": [
            "Texture.default",
            "Texture.carter"
          ]
        }
      },
      "geometry": "Array.cav_diag_geo[(query.has_property('pet:form') ? (query.property('pet:form') == 'carter') : 0.0)]",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.cav_diag_tex[(query.has_property('pet:form') ? (query.property('pet:form') == 'carter') : 0.0)]"
      ],
      "part_visibility": [
        {
          "*": true
        },
        {
          "cav_debug_mouth": "query.has_property('pet:debug') ? query.property('pet:debug') : 0.0"
        },
        {
          "helmet": "variable.helmet_layer_visible"
        },
        {
          "leftLegging": "variable.leg_layer_visible"
        },
        {
          "rightLegging": "variable.leg_layer_visible"
        },
        {
          "leftBoot": "variable.boot_layer_visible"
        },
        {
          "rightBoot": "variable.boot_layer_visible"
        },
        {
          "leftSock": "variable.boot_layer_visible && variable.leg_layer_visible"
        },
        {
          "rightSock": "variable.boot_layer_visible && variable.leg_layer_visible"
        },
        {
          "bodyArmor": "variable.chest_layer_visible && !query.has_cape"
        },
        {
          "leftArmArmor": "variable.chest_layer_visible && !query.has_cape"
        },
        {
          "rightArmArmor": "variable.chest_layer_visible && !query.has_cape"
        },
        {
          "belt": "variable.chest_layer_visible && variable.leg_layer_visible"
        }
      ],
      "rebuild_animation_matrices": true
    },
    "controller.render.player.first_person": {
      "geometry": "Array.pet_fp_geo[((query.has_property('pet:form') ? (query.property('pet:form') == 'carter') : 0.0) && variable.is_first_person && !variable.map_face_icon && !query.is_spectator && (query.has_property('pet:view') ? query.property('pet:view') == 'paws' : 1.0))]",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.pet_fp_tex[((query.has_property('pet:form') ? (query.property('pet:form') == 'carter') : 0.0) && variable.is_first_person && !variable.map_face_icon && !query.is_spectator && (query.has_property('pet:view') ? query.property('pet:view') == 'paws' : 1.0))]"
      ],
      "part_visibility": [
        {
          "*": false
        },
        {
          "rightArm": "query.get_equipped_item_name(0, 1) == '' || query.get_equipped_item_name(0, 1) == 'filled_map'"
        },
        {
          "rightSleeve": "query.get_equipped_item_name(0, 1) == '' || query.get_equipped_item_name(0, 1) == 'filled_map'"
        },
        {
          "leftArm": "(query.get_equipped_item_name(0, 1) == 'filled_map' && query.get_equipped_item_name('off_hand') != 'shield') || (query.get_equipped_item_name('off_hand') == 'filled_map' && !query.item_is_charged) || (!query.item_is_charged && (variable.item_use_normalized > 0 && variable.item_use_normalized < 1.0))"
        },
        {
          "leftSleeve": "(query.get_equipped_item_name(0, 1) == 'filled_map' && query.get_equipped_item_name('off_hand') != 'shield') || (query.get_equipped_item_name('off_hand') == 'filled_map' && !query.item_is_charged) || (!query.item_is_charged && (variable.item_use_normalized > 0 && variable.item_use_normalized < 1.0))"
        },
        {
          "pet_fp_right_paw": "(query.get_equipped_item_name(0, 1) == '' || query.get_equipped_item_name(0, 1) == 'filled_map') && ((query.has_property('pet:form') ? (query.property('pet:form') == 'carter') : 0.0) && variable.is_first_person && !variable.map_face_icon && !query.is_spectator && (query.has_property('pet:view') ? query.property('pet:view') == 'paws' : 1.0))"
        },
        {
          "pet_fp_left_paw": "((query.get_equipped_item_name(0, 1) == 'filled_map' && query.get_equipped_item_name('off_hand') != 'shield') || (query.get_equipped_item_name('off_hand') == 'filled_map' && !query.item_is_charged) || (!query.item_is_charged && (variable.item_use_normalized > 0 && variable.item_use_normalized < 1.0))) && ((query.has_property('pet:form') ? (query.property('pet:form') == 'carter') : 0.0) && variable.is_first_person && !variable.map_face_icon && !query.is_spectator && (query.has_property('pet:view') ? query.property('pet:view') == 'paws' : 1.0))"
        }
      ],
      "arrays": {
        "geometries": {
          "Array.pet_fp_geo": [
            "Geometry.default",
            "Geometry.pet_paws"
          ]
        },
        "textures": {
          "Array.pet_fp_tex": [
            "Texture.default",
            "Texture.pet_paws"
          ]
        }
      },
      "rebuild_animation_matrices": true
    }
  }
}
